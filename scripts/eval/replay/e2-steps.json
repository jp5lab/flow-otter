{
  "version": 2,
  "env": {},
  "sections": [
    {
      "name": "setup-read-discovery",
      "calls": [
        {
          "tool": "get_flow",
          "args": { "tab_id": "e2spag001" },
          "expect": { "error": false, "match": "\"nodes\"" }
        },
        {
          "tool": "analyze_flow",
          "args": { "tab_id": "e2spag001" },
          "expect": { "error": false, "match": "\"counts\"" }
        }
      ]
    },
    {
      "name": "budgeted-authoring",
      "budget": {
        "max_mcp_calls": 5,
        "max_deploy_confirmations": 1,
        "max_failed": 0,
        "max_force": 0,
        "max_force_takeover": 0,
        "max_oob": 0
      },
      "calls": [
        {
          "tool": "stage_changes",
          "args": {
            "reason": "audit e2 one-call reorganization",
            "ops": [
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n01",
                "position": { "x": 120, "y": 120 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n02",
                "position": { "x": 120, "y": 220 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n03",
                "position": { "x": 300, "y": 160 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n04",
                "position": { "x": 460, "y": 160 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n10",
                "position": { "x": 600, "y": 300 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n05",
                "position": { "x": 740, "y": 160 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n12",
                "position": { "x": 840, "y": 120 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n06",
                "position": { "x": 960, "y": 120 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n08",
                "position": { "x": 1120, "y": 120 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n07",
                "position": { "x": 960, "y": 260 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n09",
                "position": { "x": 1260, "y": 120 }
              },
              {
                "op": "move_node",
                "tab_id": "e2spag001",
                "node_id": "e2n11",
                "position": { "x": 1260, "y": 260 }
              },
              {
                "op": "update_node",
                "tab_id": "e2spag001",
                "node_id": "e2n05",
                "label": "High temp?"
              },
              {
                "op": "add_group",
                "tab_id": "e2spag001",
                "key": "e2-acquire",
                "name": "ACQUIRE",
                "node_keys": ["e2n01", "e2n02"],
                "position": { "x": 40, "y": 60 },
                "size": { "w": 160, "h": 200 }
              },
              {
                "op": "add_group",
                "tab_id": "e2spag001",
                "key": "e2-condition",
                "name": "CONDITION",
                "node_keys": ["e2n03", "e2n04", "e2n10"],
                "position": { "x": 220, "y": 100 },
                "size": { "w": 420, "h": 240 }
              },
              {
                "op": "add_group",
                "tab_id": "e2spag001",
                "key": "e2-decide",
                "name": "DECIDE",
                "node_keys": ["e2n05", "e2n12"],
                "position": { "x": 660, "y": 60 },
                "size": { "w": 220, "h": 140 }
              },
              {
                "op": "add_group",
                "tab_id": "e2spag001",
                "key": "e2-act",
                "name": "ACT",
                "node_keys": ["e2n06", "e2n08", "e2n07"],
                "position": { "x": 880, "y": 60 },
                "size": { "w": 320, "h": 240 }
              },
              {
                "op": "add_group",
                "tab_id": "e2spag001",
                "key": "e2-indicate",
                "name": "INDICATE",
                "node_keys": ["e2n09", "e2n11"],
                "position": { "x": 1200, "y": 60 },
                "size": { "w": 140, "h": 240 }
              },
              {
                "op": "add_comment",
                "tab_id": "e2spag001",
                "key": "e2-title",
                "text": "LINE B TEMPERATURE MONITOR  |  acquire -> condition -> decide -> act -> indicate",
                "position": { "x": 360, "y": 40 }
              },
              {
                "op": "add_comment",
                "tab_id": "e2spag001",
                "key": "e2-alarm-note",
                "text": "alarm path (>80) - top lane",
                "position": { "x": 1100, "y": 20 }
              },
              {
                "op": "add_comment",
                "tab_id": "e2spag001",
                "key": "e2-tap-note",
                "text": "diagnostic tap (smoothed value)",
                "position": { "x": 620, "y": 380 }
              }
            ]
          },
          "expect": { "error": false, "match": "\"staged_hash\"" }
        },
        {
          "tool": "preview_flow_diff",
          "args": { "against": "staged" },
          "expect": { "error": false, "match": "\"nodes_added\": 8" }
        },
        {
          "tool": "get_staged_change",
          "args": {},
          "expect": { "error": false, "match": "\"staged_hash\"" }
        },
        {
          "tool": "deploy_staged_change",
          "args": { "staged_hash": "$PREV.staged.staged_hash" },
          "elicitation": "accept",
          "expect": {
            "error": false,
            "match": "\"ok\": true[\\s\\S]*\"snapshot_before\": \""
          }
        }
      ]
    },
    {
      "name": "post-deploy-verify",
      "calls": [
        {
          "tool": "validate_flow",
          "args": { "tab_id": "e2spag001" },
          "expect": { "error": false, "match": "\"has_errors\": false" }
        }
      ]
    }
  ]
}
