                      "label": "Debounce repeat alarms",
                      "groupKey": "group-3",
                      "passthrough": {
                        "func": "const now = Date.now();\nconst last = context.get('lastAlarmAt') || 0;\nif (now - last < 60000) {\n    return null;\n}\ncontext.set('lastAlarmAt', now);\nreturn msg;",
                        "outputs": 1,
                        "noerr": 0,
                        "initialize": "",
                        "finalize": "",
                        "libs": []
