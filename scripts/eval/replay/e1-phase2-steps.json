                    {
                      "key": "parse",
                      "type": "function",
                      "label": "Parse reading",
                      "groupKey": "group-2",
                      "passthrough": {
                        "func": "if (typeof msg.payload === 'string') {\n    msg.payload = JSON.parse(msg.payload);\n}\nreturn msg;",
                        "outputs": 1,
                        "noerr": 0,
                        "initialize": "",
                        "finalize": "",
                        "libs": []
                      }
                    },
                    {
                      "key": "format_error",
                      "type": "function",
                      "label": "Format error",
                      "groupKey": "group-6",
                      "passthrough": {
                        "func": "msg.payload = {\n    error: msg.error && msg.error.message,\n    source: msg.error && msg.error.source && msg.error.source.name,\n    at: new Date().toISOString()\n};\nreturn msg;",
                        "outputs": 1,
                        "noerr": 0,
                        "initialize": "",
                        "finalize": "",
                        "libs": []
                      }
                    },
