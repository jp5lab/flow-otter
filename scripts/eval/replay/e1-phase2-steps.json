                      "type": "function",
                      "label": "Validate range 0-200",
                      "groupKey": "group-2",
                      "passthrough": {
                        "func": "const r = msg.payload && msg.payload.raw;\nif (typeof r !== 'number' || r < 0 || r > 2000) {\n    node.error('reading outside 0-200 degC range (raw=' + r + ')', msg);\n    return null;\n}\nreturn msg;",
                        "outputs": 1,
                        "noerr": 0,
                        "initialize": "",
                        "finalize": "",
                        "libs": []
                      }
