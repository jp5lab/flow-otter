                      "groupKey": "group-2",
                      "passthrough": {
                        "func": "msg.payload.degC = msg.payload.raw / 10;\nreturn msg;",
                        "outputs": 1,
                        "noerr": 0,
                        "initialize": "",
                        "finalize": "",
                        "libs": []
                      }
                    },
                    {
