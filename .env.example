# FlowOtter — example environment configuration.
#
# Copy to `.env` and adjust, or pass these directly to the MCP client launcher.
# The server boots WITHOUT a Node-RED target unless one of the FLOW_SOURCE pairs
# below is set; agents call the set_target tool at runtime to point at a runtime.

# ============================================================
# Target binding (optional — agent can call set_target instead)
# ============================================================

# FLOW_SOURCE selects how flows are accessed. Leave unset to require runtime set_target.
#   admin-api : talk to Node-RED's Admin API over HTTP
#   file      : read/write a local flows.json directly
# FLOW_SOURCE=admin-api

# For FLOW_SOURCE=admin-api
# NODE_RED_BASE_URL=http://192.168.1.10:1880

# Auth — pick ONE shape. The token value is never persisted to disk.
# NODE_RED_AUTH_TOKEN=...                    # Bearer token (admin-api only)
# NODE_RED_AUTH_USERNAME=admin               # password grant
# NODE_RED_AUTH_PASSWORD=...
# NODE_RED_AUTH_HEADER=Authorization         # override for reverse-proxy / SSO

# For FLOW_SOURCE=file
# FLOW_FILE_PATH=./flows.json

# Logical name used to scope persisted state under ~/.flow-otter/<ENVIRONMENT_NAME>/
ENVIRONMENT_NAME=default

# ============================================================
# Safety tiers — default config is read-only
# ============================================================

# Master switch. When true (default), ALL write/deploy/dangerous tiers are blocked.
READ_ONLY_MODE=true

# Enable authoring tools (add_node, wire_nodes, etc.). Requires READ_ONLY_MODE=false.
ENABLE_WRITE_TOOLS=false

# Enable deploy/rollback. Requires ENABLE_WRITE_TOOLS=true.
ENABLE_DEPLOY_TOOLS=false

# Enable destructive replace_flows / delete_tab / reset_runtime / per-flow CRUD.
# Each invocation still requires a prepare_dangerous_operation token.
ENABLE_DANGEROUS_TOOLS=false

# Refuses staged deploy if the runtime's flows.json hash differs from the last snapshot.
REQUIRE_DRIFT_CHECK_BEFORE_DEPLOY=true

# ============================================================
# Optional overrides
# ============================================================

# Per-target state directory overrides. Default: ~/.flow-otter/<ENVIRONMENT_NAME>/
# SNAPSHOT_DIR=
# STAGING_DIR=
# AUDIT_LOG_PATH=

# Bounded /comms debug ring buffer size. Integer 1..10000, default 500.
# DEBUG_BUFFER_SIZE=500

# Per-session agent identity. Defaults to pid-<process_id>. Useful for multi-session staging guards.
# FLOWOTTER_SESSION_ID=
